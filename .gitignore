# OS / editor / tooling artifacts
.DS_Store
.venv/
.pytest_cache/
.ruff_cache/
__pycache__/
*.py[cod]
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.idea/
.vscode/
.env

# Research cases are local by default — force-add to commit: git add -f research/<case>/
research/

# Personal, per-machine Claude settings
.claude/settings.local.json

# Local-only per-tool MCP configs, created by `research source enable`. The edit hooks are shared.
.mcp.json
.cursor/*
!.cursor/hooks.json
.codex/*
!.codex/hooks.json

config/sources.json
# Copied from the bundle by `research source enable snowflake`
config/snowflake-mcp-tools.yaml

# Verification runs (.agents/skills/verify-agentic-research-loop)
.verify/

# Agent docs — only allow curated paths under .agents/docs/
.agents/docs/*
!.agents/docs/examples/
!.agents/docs/examples/**
!.agents/docs/architecture.md
!.agents/docs/setup.md
!.agents/docs/decisions/
!.agents/docs/decisions/**
